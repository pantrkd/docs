{
  "openapi": "3.0.2",
  "info": {
    "title": "Course Scheduler REST API",
    "description": "Defines the API specification for communication between the backend and frontend. Additional clients on different platforms may be created by consuming this API.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8989/api/v1",
      "description": "development server"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPublic"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "description": "Email already in use",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Password failed policy checks (below 12 characters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful. Returns a long-lived auth token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "423": {
            "description": "Account temporarily locked out after repeated failed login attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh token",
        "description": "Invalidates the presented token and issues a new one.",
        "operationId": "refreshToken",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "New auth token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout",
        "description": "Revokes the current token being used.",
        "operationId": "logoutUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out successfully; token revoked"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get Token Owner",
        "description": "Get the current authenticated user information.",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The user who owns the token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/sections": {
      "summary": "Course section objects",
      "description": "filter, sort and return a list of section objects",
      "get": {
        "operationId": "filterSections",
        "summary": "Search Sections",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "fuzzy search against title, subject, subjectDesc, courseNumber, crn, instructor names, meetings.days, meetings.building, campus, attributes",
            "example": "enc 1101 no cost section thursday"
          },
          {
            "name": "crn",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "example": 82001
          },
          {
            "name": "subject",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true,
            "example": [
              "ENC",
              "MAC"
            ]
          },
          {
            "name": "courseNumber",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1101
          },
          {
            "name": "term",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Fall 2026"
          },
          {
            "name": "campus",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Main Campus-UNF"
          },
          {
            "name": "instructor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Mary Humphries"
          },
          {
            "name": "attributes",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true,
            "example": [
              "General Education Course"
            ]
          },
          {
            "name": "scheduleType",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "Class"
          },
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday",
                  "sunday"
                ]
              }
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "minSeatsRemain",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 3
          },
          {
            "name": "minWaitlistRemain",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "minCreditHours",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "example": 3
          },
          {
            "name": "maxCreditHours",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "example": 4
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "crn",
                "title",
                "subject",
                "courseNumber",
                "creditHours",
                "seatsRemaining",
                "primaryInstructor"
              ]
            },
            "example": "seatsRemaining"
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            },
            "example": "asc"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number for paginated results.",
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "description": "Results per page.",
            "example": 25
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Section"
                  }
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "description": "Unable to fetch data from the database"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Long-lived auth token."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded for this endpoint; retry after a timeout",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Section": {
        "type": "object",
        "required": [
          "crn",
          "title",
          "subject",
          "courseNumber",
          "creditHours",
          "term",
          "instructor",
          "meetings",
          "campus",
          "status",
          "scheduleType",
          "attributes",
          "linked",
          "subjectDesc"
        ],
        "properties": {
          "crn": {
            "type": "integer",
            "example": 83013
          },
          "title": {
            "type": "string",
            "example": "(GW) Writing for Audience and Purpose"
          },
          "subject": {
            "type": "string",
            "example": "ENC"
          },
          "subjectDesc": {
            "type": "string",
            "example": "English Composition"
          },
          "courseNumber": {
            "type": "integer",
            "example": 1101
          },
          "creditHours": {
            "type": "integer",
            "example": 3
          },
          "term": {
            "type": "string",
            "example": "Fall 2026"
          },
          "instructor": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Instructor"
            }
          },
          "meetings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meeting"
            }
          },
          "campus": {
            "type": "string",
            "example": "Main Campus-UNF"
          },
          "status": {
            "$ref": "#/components/schemas/SectionStatus"
          },
          "scheduleType": {
            "type": "string",
            "example": "Class"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "State Core Communication",
              "Gen Edu: English Composition",
              "General Education Course"
            ]
          },
          "linked": {
            "type": "array",
            "description": "Linked section CRNs",
            "items": {
              "type": "integer"
            },
            "example": []
          }
        }
      },
      "Instructor": {
        "type": "object",
        "required": [
          "name",
          "isPrimary"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Kathrine (Kathy) Jaffe McCormick"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "n0385603@unf.edu"
          },
          "isPrimary": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Meeting": {
        "type": "object",
        "required": [
          "days",
          "hasMeeting",
          "type"
        ],
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "monday",
                "tuesday",
                "wednesday",
                "thursday",
                "friday",
                "saturday",
                "sunday"
              ]
            }
          },
          "startTime": {
            "$ref": "#/components/schemas/Time"
          },
          "endTime": {
            "$ref": "#/components/schemas/Time"
          },
          "hasMeeting": {
            "type": "boolean",
            "example": true
          },
          "type": {
            "type": "string",
            "example": "class"
          },
          "building": {
            "type": "string",
            "nullable": true,
            "example": "9-mcaffe auditor hall"
          },
          "room": {
            "type": "string",
            "nullable": true,
            "example": "1411"
          },
          "startDate": {
            "$ref": "#/components/schemas/SimpleDate"
          },
          "endDate": {
            "$ref": "#/components/schemas/SimpleDate"
          }
        }
      },
      "Time": {
        "type": "object",
        "required": [
          "hour",
          "minute"
        ],
        "properties": {
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "example": 16
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "example": 30
          }
        }
      },
      "SimpleDate": {
        "type": "object",
        "required": [
          "year",
          "month",
          "day"
        ],
        "properties": {
          "year": {
            "type": "integer",
            "example": 2026
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "example": 8
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "example": 17
          }
        }
      },
      "SectionStatus": {
        "type": "object",
        "required": [
          "isFull",
          "seatsRemaining",
          "totalSeats",
          "hasWaitlist"
        ],
        "properties": {
          "isFull": {
            "type": "boolean",
            "example": false
          },
          "seatsRemaining": {
            "type": "integer",
            "example": 12
          },
          "totalSeats": {
            "type": "integer",
            "example": 24
          },
          "hasWaitlist": {
            "type": "boolean",
            "example": true
          },
          "waitlistRemaining": {
            "type": "integer",
            "nullable": true,
            "example": 10
          },
          "waitlistTotal": {
            "type": "integer",
            "nullable": true,
            "example": 10
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "description": "Minimum 12 characters."
          },
          "display_name": {
            "type": "string",
            "maxLength": 100
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "auth_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Returns the email of the authenticated user.",
            "example": "user@university.edu"
          }
        }
      },
      "UserPublic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "display_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_verification",
              "active",
              "disabled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code",
            "example": "invalid_credentials"
          },
          "message": {
            "type": "string",
            "description": "Human readable message"
          }
        }
      }
    }
  }
}